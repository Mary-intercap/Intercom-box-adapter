# ---------------------------------------------------------------------------
# box-support-agent - example configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder; none of them are real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# debug | info | warn | error
# `debug` opts in to verbose logging, which INCLUDES customer message text.
# Do not use `debug` in production.
LOG_LEVEL=info

# --- Intercom --------------------------------------------------------------
# REQUIRED. App > Basic Info > Client Secret. Used only to verify the
# X-Hub-Signature on incoming webhooks. Never sent anywhere.
INTERCOM_CLIENT_SECRET=replace-with-intercom-client-secret

# OPTIONAL and UNUSED IN V1. The V1 app needs only the "Read conversations"
# webhook permission; the webhook payload already carries the message, so no
# Intercom API call is made. Reserved for V2 (replying to customers).
# INTERCOM_ACCESS_TOKEN=replace-with-intercom-access-token

# --- Dashboard -------------------------------------------------------------
# The dashboard at GET / is always on. It shows every triaged conversation.
#
# It serves customer support messages verbatim, with no authentication unless
# you set a token here. Leaving it unset is fine on localhost; set it for
# anything that anyone else can reach. Minimum 16 characters.
# DASHBOARD_TOKEN=generate-a-long-random-value-here

# How many recent conversations the dashboard keeps. In memory only - the
# history is lost on restart.
DASHBOARD_MAX_RECORDS=200

# --- Slack (optional) ------------------------------------------------------
# OPTIONAL. Leave unset to use the dashboard alone. Set it to ALSO post each
# triaged conversation to Slack. Treat as a secret: anyone holding it can post
# to the channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/replace-me

# --- AI provider -----------------------------------------------------------
# anthropic | mock | noop
#
#   anthropic  the real classifier. Needs AI_API_KEY.
#   mock       deterministic keyword matching, no network, no API key, no spend.
#              For local development and demos only - it is NOT AI and will be
#              confidently wrong. Every result it produces says so.
#   noop       no classification at all; everything shows as Unclassified.
AI_PROVIDER=mock

# REQUIRED only when AI_PROVIDER=anthropic. A programmatic Anthropic API key
# (console.anthropic.com > API Keys). This is NOT the same thing as a Claude
# Code / Claude.ai subscription - those do not issue API credentials.
AI_API_KEY=sk-ant-replace-me

# Model used for triage classification.
AI_MODEL=claude-opus-5

# low | medium | high | xhigh | max
# Triage is a simple classification task; `low` keeps cost and latency down.
AI_EFFORT=low

# Milliseconds to wait for the model before giving up and sending a
# degraded ("triage unavailable") Slack notification.
AI_TIMEOUT_MS=30000
