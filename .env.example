# ---------------------------------------------------------------------------
# box-support-agent - example configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder; none of them are real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# debug | info | warn | error
# `debug` opts in to verbose logging, which INCLUDES customer message text.
# Do not use `debug` in production.
LOG_LEVEL=info

# --- Intercom --------------------------------------------------------------
# REQUIRED. App > Basic Info > Client Secret. Used only to verify the
# X-Hub-Signature on incoming webhooks. Never sent anywhere.
INTERCOM_CLIENT_SECRET=replace-with-intercom-client-secret

# OPTIONAL and UNUSED IN V1. The V1 app needs only the "Read conversations"
# webhook permission; the webhook payload already carries the message, so no
# Intercom API call is made. Reserved for V2 (replying to customers).
# INTERCOM_ACCESS_TOKEN=replace-with-intercom-access-token

# --- Slack -----------------------------------------------------------------
# REQUIRED. Slack Incoming Webhook URL. Treat as a secret: anyone holding it
# can post to the channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/replace-me

# --- AI provider -----------------------------------------------------------
# anthropic | noop
# `noop` skips the model entirely and emits a "triage unavailable" Slack
# notification. Useful for wiring up Intercom + Slack before AI credentials
# exist.
AI_PROVIDER=anthropic

# REQUIRED when AI_PROVIDER=anthropic. A programmatic Anthropic API key
# (console.anthropic.com > API Keys). This is NOT the same thing as a Claude
# Code / Claude.ai subscription - those do not issue API credentials.
AI_API_KEY=sk-ant-replace-me

# Model used for triage classification.
AI_MODEL=claude-opus-5

# low | medium | high | xhigh | max
# Triage is a simple classification task; `low` keeps cost and latency down.
AI_EFFORT=low

# Milliseconds to wait for the model before giving up and sending a
# degraded ("triage unavailable") Slack notification.
AI_TIMEOUT_MS=30000
